# Database (Neon or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/partyinvites"

# Server
PORT=3002
CORS_ORIGIN=http://localhost:5174

# Optional: local uploads directory (only used when R2 is not configured)
UPLOADS_DIR=uploads

# --- Firebase Admin (required for auth) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- R2 (production image storage) ---
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
